gcc -march=native \
	-O3 -ffast-math -g -fno-omit-frame-pointer -Wno-unused-result \
	-D NUMBER_OF_PARTICLES=800 \
	src/md_a/MD.cpp -lm \
	-o ./src/md_a/md_profiling
perf stat \
	--repeat 5 \
	--event task-clock,cycles,instructions \
	--output results/md_a_serial_vec/metric_N800.txt \
	sh -c './src/md_a/md_profiling \
			< ./inputdata.txt \
			> /dev/null'
mv --force cp_average.txt cp_output.txt cp_traj.xyz results/md_a_serial_vec/
